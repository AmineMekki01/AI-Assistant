# ── OpenAI ─────────────────────────────────────────────────────────
# Get yours at https://platform.openai.com/account/api-keys
OPENAI_API_KEY=sk-your-api-key-here

# Models (optional overrides - defaults are fine)
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
OPENAI_REALTIME_VOICE=ash

# Requires requirements-speaker.txt and an enrolled profile in Voice settings.
# When enabled, missing/unavailable profiles block voice commands.
JARVIS_SPEAKER_VERIFICATION_ENABLED=False
JARVIS_SPEAKER_VERIFICATION_THRESHOLD=0.35
JARVIS_SPEAKER_PROFILE_PATH=~/.jarvis/voice/speaker_profile.json
OPENAI_UTILITY_MODEL=gpt-5.4-nano
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── Web search (Tavily) ───────────────────────────────────────────
# Get yours at https://tavily.com
TAVILY_API_KEY=tvly-your-api-key-here

# ── Google OAuth (Gmail + Calendar) ───────────────────────────────
# Set up at https://console.cloud.google.com
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# Token cache (leave default unless you have a reason)
GOOGLE_TOKEN_PATH=~/.jarvis/google_token.json

# ── Qdrant (memory + Obsidian RAG) ────────────────────────────────
# `cd infra/qdrant && docker compose up -d` to run the local service.
QDRANT_URL=http://localhost:6333
# Set this only when a remote Qdrant deployment requires authentication.
QDRANT_API_KEY=
QDRANT_MEMORY_COLLECTION=long_term_memory
# New named-vector collection: OpenAI dense semantic search + Qdrant BM25.
QDRANT_VAULT_COLLECTION=obsidian_vault_hybrid

# ── Obsidian vault ────────────────────────────────────────────────
# Can also be set via the JARVIS Settings UI; the UI takes precedence.
OBSIDIAN_VAULT_PATH=~/Documents/Obsidian

# ── Identity (optional, single-user default) ──────────────────────
JARVIS_USER_ID=user

# ── Runtime and voice behaviour (optional overrides) ─────────────
JARVIS_HOST=localhost
JARVIS_WEBSOCKET_PORT=8000
JARVIS_API_PORT=8001
JARVIS_CAPABILITY_TIMEOUT_SECONDS=90
JARVIS_VOICE_FOLLOWUP_SECONDS=300
JARVIS_VOICE_MAX_RECORDING_SECONDS=24
JARVIS_VOICE_MIC_RESUME_SECONDS=0.2
JARVIS_MUSIC_DUCK_TARGET_VOLUME=38
# Comma-separated capability names/modules. Leave empty by default.
JARVIS_DISABLED_CAPABILITIES=
JARVIS_CAPABILITY_MODULES=

# NOTE: Zimbra mail and Apple Calendar are configured entirely
# from the Settings UI (~/.jarvis/settings.json) - no env vars needed.
